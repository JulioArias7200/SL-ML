# ==============================================================================
# PROYECTO MACHINE LEARNING NO SUPERVISADO (CHICAGO CPD) - .gitignore
# ==============================================================================

# Entornos Virtuales de Python
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Bytecode y Caché de Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# Jupyter Notebooks Checkpoints
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# Datasets Masivos y Archivos Pesados (> 100 MB límite GitHub)
# El dataset original de Chicago supera los 309.5 MB y no debe versionarse en Git (se usa Parquet 20 MB)
data/chicago_benchmark/bronze/*.csv
# Carpetas de trabajo temporal y librerías externas de scraping
Scrapling-main/
Scraping_v6/
*.sqlite
data/**/*.sqlite
data/*.csv
data/*.snappy
data/*.zip
data/*.tar.gz
data/*.json.gz
archive*/
data_processed/
!data/data.txt
!data/.gitkeep

# Modelos Serializados y Pesos Binarios
models_saved/*.joblib
models_saved/*.pkl
models_saved/*.h5
!models_saved/.gitkeep

# Variables de Entorno y Credenciales
.env
.env.*
!.env.example

# Logs y Archivos Temporales
*.log
*.tmp
*.bak
instance/
.webassets-cache


# LaTeX / Informes Académicos (Auxiliares y artefactos de compilación)
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.lof
*.lot
*.out
*.toc
*.synctex.gz
*.bcf
*.run.xml
*.nav
*.snm
*.vrb
# Si prefieres no versionar el PDF compilado, descomenta la siguiente línea:
*.pdf


# Configuraciones de IDE y Editores de Código
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.fleet/

# Archivos de Sistema Operativo
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# Vistas Prototipo / Borradores Standalone (Reemplazadas por templates/ modulares Jinja2)
page1.html
page2.html
page3.html


.skills/
